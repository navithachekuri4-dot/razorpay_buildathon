# --- Database ---
DATABASE_URL=sqlite:///./revenue_recovery.db

# --- Gemini (AI diagnosis) ---
# If left blank, the agent automatically uses the deterministic rule-based
# fallback diagnoser. The app must (and does) work with zero AI credentials.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# --- Razorpay Test Mode ---
# MUST start with rzp_test_. Live keys (rzp_live_) are rejected by the app
# even if pasted here by mistake — see razorpay_service.py.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# --- Agent safety configuration ---
MAX_RETRY_COUNT=3
